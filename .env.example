# Copy this to .env and fill in values. .env is gitignored.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Flask ----------------------------------------------------------------
# Random hex — `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefghij.supabase.co
SUPABASE_URL=
# Anon (public) key — safe to expose to the browser.
SUPABASE_ANON_KEY=
# Service role key — server-only. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket where uploaded applicant documents live (private).
SUPABASE_STORAGE_BUCKET=tenant-documents

# --- Database -------------------------------------------------------------
# Use the POOLED connection string (port 6543). Serverless must not use port 5432.
# postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Append ?prepared_statement_cache_size=0 when hosting on Vercel.
DATABASE_URL=
